#!/bin/bash
export LD_LIBRARY_PATH="/home/guuu/Dev/filament1/bin/lib:$LD_LIBRARY_PATH"
# Strip common flags that frankenphp php-cli doesn't handle natively
ARGS=()
SKIP_NEXT=0
for arg in "$@"; do
    if [ "$SKIP_NEXT" -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    if [[ "$arg" == "-d" ]]; then
        SKIP_NEXT=1
        continue
    fi
    if [[ "$arg" == -d* ]]; then
        continue
    fi
    ARGS+=("$arg")
done
exec "/home/guuu/Dev/filament1/bin/frankenphp" php-cli "${ARGS[@]}"
